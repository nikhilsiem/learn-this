# Copy to .env.local for local dev. In Vercel, add the same keys under
# Project Settings -> Environment Variables. Never commit real values.

# --- Auth (NextAuth v5 + Google OAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local: http://localhost:3000   Production: https://learn-this.vercel.app
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase (Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (any OpenAI-compatible API; defaults to Gemini free tier) ---
# Free key: https://aistudio.google.com/apikey
LLM_API_KEY=
# Optional overrides. Examples:
#   Groq (open-source Llama):  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter free models:    LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Rate limiting (optional; falls back to in-memory if unset) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
